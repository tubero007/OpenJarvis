#!/usr/bin/env python3
"""Test stand-in for macOS `security` (generic-password subset), backed by a
JSON file ($FAKE_KEYCHAIN). Logs its argv to $FAKE_SECURITY_LOG so tests can
check that secrets never appear on the command line."""
import json, os, shlex, sys

store = os.environ.get("FAKE_KEYCHAIN", "/tmp/fake-keychain.json")
log = os.environ.get("FAKE_SECURITY_LOG")
if log:
    with open(log, "a") as fh:
        fh.write(json.dumps(sys.argv[1:]) + "\n")

def load():
    try:
        return json.load(open(store))
    except Exception:
        return {}

def run(args):
    cmd, opts, i = args[0], {}, 1
    while i < len(args):
        if args[i] in ("-s", "-a", "-l", "-w") and i + 1 < len(args) and not (args[i] == "-w" and i + 1 == len(args)):
            opts[args[i]] = args[i + 1]; i += 2
        else:
            opts[args[i]] = True; i += 1
    data = load()
    key = opts.get("-a")
    if cmd == "find-generic-password":
        if key not in data:
            sys.stderr.write("security: SecKeychainSearchCopyNext: The specified item could not be found in the keychain.\n")
            return 44
        if opts.get("-w") is True:
            print(data[key])
        return 0
    if cmd == "add-generic-password":
        if key in data and "-U" not in opts:
            return 45
        data[key] = opts["-w"]; json.dump(data, open(store, "w")); return 0
    if cmd == "delete-generic-password":
        if key not in data:
            return 44
        data.pop(key); json.dump(data, open(store, "w")); return 0
    return 1

if sys.argv[1:] == ["-i"]:
    rc = 0
    for line in sys.stdin:
        if line.strip():
            rc = run(shlex.split(line)) or rc
    sys.exit(rc)
sys.exit(run(sys.argv[1:]))
