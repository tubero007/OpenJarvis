#!/usr/bin/env bash
# Test stand-in for macOS `say`. Logs what it was asked to speak and "speaks"
# for a time proportional to the text so stop/interrupt can be exercised.
if [[ "$1" == "-v" && "$2" == "?" ]]; then
  cat <<'V'
Alex                en_US    # Most people recognize me by my voice.
Daniel              en_GB    # Hello! My name is Daniel.
Eddy (English (UK)) en_GB    # Hello! My name is Eddy.
Karen               en_AU    # Hello! My name is Karen.
Thomas              fr_FR    # Bonjour, je m’appelle Thomas.
V
  exit 0
fi
voice=""; rate=""; file=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -v) voice="$2"; shift 2;;
    -r) rate="$2"; shift 2;;
    -f) file="$2"; shift 2;;
    *) text="$*"; break;;
  esac
done
[[ "$file" == "-" ]] && text="$(cat)"
log="${FAKE_SAY_LOG:-/dev/null}"
trap 'printf "STOPPED\t%s\n" "$text" >> "$log"; exit 143' TERM
printf "START\t%s\t%s\t%s\n" "$voice" "$rate" "$text" >> "$log"
words=$(wc -w <<<"$text")
# ~0.12 s per word, real-time-ish
sleep "$(awk -v w="$words" 'BEGIN{printf "%.2f", w*0.12}')" &
wait $!
printf "DONE\t%s\n" "$text" >> "$log"
